{
    "name": "@worldlens/cli",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Standalone BlueMap server CLI (render, watch, webserver)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "bluemap-cli": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/copy-webapp.mjs",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@worldlens/config": "workspace:*",
        "@worldlens/engine": "workspace:*",
        "@worldlens/server": "workspace:*",
        "@worldlens/shared": "workspace:*"
    },
    "devDependencies": {
        "@worldlens/worldgen": "workspace:*",
        "@types/pngjs": "^6.0.5",
        "pngjs": "^7.0.0"
    }
}
