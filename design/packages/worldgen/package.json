{
    "name": "@worldlens/worldgen",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Deterministic synthetic Minecraft world generator writing Anvil format directly",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "worldlens-worldgen": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@worldlens/nbt": "workspace:*",
        "@worldlens/shared": "workspace:*"
    },
    "devDependencies": {
        "@worldlens/engine": "workspace:*"
    }
}
