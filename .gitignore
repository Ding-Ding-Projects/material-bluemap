# Java toolchain and build state for the vendored upstream renderer.
# Provisioned into the repository so no machine-wide toolchain is touched, and
# ignored because it is over a gigabyte of downloaded Gradle and dependencies.
tools/oracle/.gradle/
tools/oracle/jdk/
tools/oracle/out/

# Built artefacts of the vendored upstream source.
vendor/BlueMap/**/build/
vendor/BlueMap/.gradle/

# Generated test worlds.
test-world/
*.mca

# BlueMap render output. The CLI resolves its storage root and its data folder
# relative to the working directory, not the config folder, so running it from
# the repository root drops tens of megabytes of tiles and a downloaded Mojang
# client jar straight into the tree. Never commit either.
/web/
/data/

# Compiled classes and dumps of the unit-level PRBM reference capture.
tools/oracle/prbm/out/
